"`ln -s ../b.txt um/c/b.txt`\n"
"`cat um/c/b.txt`\n"
"> hello\n"
"`ls um`\n"
"> \"a/b.txt\"\n"
"> \"a/c\"\n"
"`rm um/c/e.txt`\n"
"`rmdir um/c/d`\n"
"```"

