"    // Um attempt to reborrow vai lead to um erro.\n"
"    // let _reborrow = &count; \n"
"    // ^ TODO: try uncommenting este line.\n"

#: src/fn/closures/capture.md:62
msgid ""
"// The closure no longer needs to borrow `&mut count`. Therefore, it is\n"
"    // possible to reborrow without an error\n"
msgstr ""
"// O closure no longer needs to emprestar `&mut count`. Therefore, it is\n"
"    // possible to reborrow sem um erro\n"

