msgid "// This is a simple macro named `say_hello`.\n"
msgstr ""
"// Este is um simple macro named `say_hello`.\n"

#: src/macros.md:16
msgid "// `()` indicates that the macro takes no argument.\n"
msgstr ""
"// `()` indicates aquele o macro takes no argumento.\n"

#: src/macros.md:18
msgid "// The macro will expand into the contents of this block.\n"
msgstr ""
"// O macro vai expand no contents of este block.\n"

